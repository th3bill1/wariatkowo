PORT=3000
COOKIE_SECURE=true

# Server-side Google OAuth/OIDC credentials. Never expose these as VITE_* values.
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Existing identity-only Wariatkowo login callback.
GOOGLE_REDIRECT_URI=https://wariatkowo.wwojcik.com/api/auth/google/callback
# Separate, explicit Google Calendar authorization callback.
GOOGLE_CALENDAR_REDIRECT_URI=https://wariatkowo.wwojcik.com/api/integrations/google-calendar/callback
# 32 random bytes encoded as base64url; generate as documented in README.md.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Exactly one private account per existing household profile; placeholders only.
GOOGLE_ALLOWED_USERS_JSON={"first-private-account@example.com":"misiek","second-private-account@example.com":"miska"}

DATABASE_PATH=./data/wariatkowo.db
MIGRATIONS_PATH=./migrations
# Resolves to /app/data/images in Docker; keep local development images ignored.
IMAGES_PATH=./data/images
# Private GitHub Actions -> Wariatkowo release upload credential. Never expose it
# through VITE_* or EXPO_PUBLIC_* variables.
WARIATKOWO_MOBILE_DEPLOY_TOKEN=
# Stored under the existing persistent /app/data mount in Docker.
MOBILE_RELEASES_PATH=./data/mobile
# Optional upload/retention limits.
MOBILE_RELEASE_MAX_SIZE_MB=200
MOBILE_RELEASE_RETENTION=5
# Optional override for the built frontend served by Express.
FRONTEND_DIST_PATH=./dist

HA_URL=http://home-assistant.local:8123
HA_TOKEN=
HA_TIMEOUT_MS=5000

HA_LIGHT_LIVING_ROOM=
HA_LIGHT_BEDROOM=
# A logical light can target one entityId or several entityIds.
HA_LIGHTS_JSON={"living-room":{"name":"Salon","entityIds":["light.living_room_1","light.living_room_2"]},"bedroom":{"name":"Sypialnia","entityId":"light.bedroom"}}

HA_AC=climate.living_room
HA_AC_SWITCHES_JSON={"eco":{"name":"Eco","entityId":"switch.living_room_ac_eco"}}
HA_AC_SELECTS_JSON={"sleep-mode":{"name":"Tryb snu","entityId":"select.living_room_ac_sleep_mode"}}
HA_AC_NUMBERS_JSON={"variable-fan-speed":{"name":"Płynna prędkość nawiewu","entityId":"number.living_room_ac_fan_speed"}}
HA_TV=
HA_TV_REMOTE=
HA_XBOX=
HA_XBOX_REMOTE=

HA_SCENE_GAMING=
HA_SCENE_MOVIE=
HA_SCENE_GOOD_NIGHT=
# Optional mapping, for example:
# HA_SCENES_JSON={"away":{"name":"Wychodzimy","entityId":"script.away"}}
HA_SCENES_JSON=

# Needed only when the optional Compose tunnel profile is enabled.
CLOUDFLARE_TUNNEL_TOKEN=
