{
  "name": "wariatkowo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "wrangler pages dev dist",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=wariatkowo",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "d1:migrate:local": "wrangler d1 migrations apply wariatkowo-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply wariatkowo-db --remote",
    "setup:pins": "node scripts/setup-pins.mjs",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.1.1",
    "@fontsource/nunito": "^5.1.1",
    "lucide-react": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
