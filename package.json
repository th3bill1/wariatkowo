{
  "name": "wariatkowo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:web": "vite",
    "dev:mobile": "npm run start --workspace @wariatkowo/mobile",
    "android": "npm run android --workspace @wariatkowo/mobile",
    "dev:server": "node scripts/dev-server.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "start": "node build/server/index.js",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "db:migrate": "node scripts/run-server-tool.mjs server/db/migrateCli.ts",
    "db:import": "node scripts/run-server-tool.mjs server/db/importD1Cli.ts",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/nunito": "^5.1.1",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/react": "~19.2.4",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.12",
    "expo-router": "~57.0.15",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true
  }
}
